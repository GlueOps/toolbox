#!/usr/bin/env bash
# argocd, with the edge token attached.
#
# ARGOCD_AUTH_TOKEN is NOT enough. The CLI sends its credential in a `Token:`
# header, which oauth2-proxy does not look at - it reads `Authorization`. So with
# only ARGOCD_AUTH_TOKEN set, the edge sees no bearer at all and answers every
# request with a login redirect, which surfaces as "rpc error: unexpected EOF".
#
#   ARGOCD_AUTH_TOKEN=x  ->  Token: x                    (edge ignores it)
#   -H "Authorization: …" ->  Authorization: Bearer x    (edge accepts it)
#
# -H is a global flag, so it can go before the subcommand and this wrapper stays
# trivial. ArgoCD itself also accepts a bearer, and it is configured with the
# toolbox audience in allowedAudiences, so the one header satisfies both layers.
set -euo pipefail
if ! TOKEN="$(toolbox-token --no-login)"; then
    echo "toolbox: not authenticated. Run 'toolbox-login' first." >&2
    exit 1
fi
exec /usr/local/bin/argocd.real -H "Authorization: Bearer ${TOKEN}" "$@"
